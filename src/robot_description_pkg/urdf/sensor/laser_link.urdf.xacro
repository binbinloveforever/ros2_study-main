<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find robot_description_pkg)/urdf/common_inertia.xacro"/>
    <xacro:macro name="laser_link_xacro" params="xyz">
        <link name="laser_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.025" length="0.04"/>
                </geometry>
                <material name="blue">
                    <color rgba="0.1 0.3 1.0 1.0"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.025" length="0.04"/>
                </geometry>
            </collision>

            <xacro:cylinder_inertia_z m="0.05" r="0.025" h="0.04"/>
        </link>

        <joint name="laser_link_joint" type="fixed">
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="laser_link"/>
        </joint>

        <gazebo reference="laser_link">
            <material>Gazebo/Blue</material>
        </gazebo>
    </xacro:macro>
</robot>
